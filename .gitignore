# Deny by default: only end-user facing content is tracked.
# Add a root here only when it is end-user facing.
/*
!/.gitignore
!/.gitattributes
!/VERSION
!/README.md
!/Cargo.toml
!/Cargo.lock
# Layer folders (README.md, Layout).
!/core/
!/platform/
!/servers/
!/scene/
!/modules/
!/pipeline/
!/authoring/
!/apps/
!/tests/
!/thirdparty/
# Build output inside a tracked folder: the thirdparty workspace's and each library's.
/thirdparty/target/
/thirdparty/*/build/
